# The prototype MCP gateway as a daemon (deploy/mcp-gateway/README.md).
# Install: sudo install -m 0644 mcp-gateway.service /etc/systemd/system/ && sudo systemctl daemon-reload
#          sudo systemctl enable --now mcp-gateway

[Unit]
Description=cerp prototype MCP gateway (im, pm, crm, cfm on 127.0.0.1:7410, under /mcp/webos)
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=ec2-user
WorkingDirectory=/home/ec2-user/projects/cerp
Environment=MCP_DB_DIR=/home/ec2-user/environment/cluster/domains/4/D/4DF72D07-B9AD-45E8-96A7-F45A9A1B86EC/db
ExecStart=/home/ec2-user/projects/cerp/.venv/bin/python deploy/mcp-gateway/gateway.py --port 7410 --prefix /mcp/webos
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
